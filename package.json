{
  "name": "ai-race",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "dev": "vite",
    "build": "node tools/build.mjs",
    "lint": "eslint . && npm run typecheck",
    "bots": "node tools/train-bots.mjs",
    "compare": "node tools/compare-parents.mjs",
    "demo": "node tools/make-demo-entries.mjs 300 demo-entries --seal",
    "seal": "node tools/seal.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:engine": "node --test \"test/engine/*.test.mjs\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "acorn": "8.15",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@reely/async": "0.1.3",
    "@reely/basics": "0.1.4",
    "@reely/colors": "0.0.9",
    "@reely/dommy": "0.6.2",
    "@reely/dommy-kit": "0.2.3",
    "@reely/logger": "0.0.5",
    "@reely/signals": "0.2.0",
    "@reely/strings": "0.0.10"
  }
}

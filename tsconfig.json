{
  // Проверка типов (npm run typecheck, входит в npm run lint): engine/ и app/ — TypeScript, строго.
  // Сгенерированные app/generated/*.js дают типы тем, кто их импортирует, но сами не проверяются.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    // Только свои типы: без этого tsc подхватывает @types из папок выше проекта (например, ~/node_modules/@types/node)
    "types": [],
    // Импорт с расширением .ts (import './car.ts'): так файлы запускаются в Node без сборки
    "allowImportingTsExtensions": true,
    // JSX собирается в вызовы @reely/dommy — настоящие DOM-элементы, без виртуального DOM (#20)
    "jsx": "react-jsx",
    "jsxImportSource": "@reely/dommy",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Только то, что можно просто стереть (без enum, namespace, параметров-свойств):
    // так Node запускает .ts без сборки, а Vite собирает каждый файл отдельно
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["engine/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "app/globals.d.ts"]
}

{
  // Строгая проверка нового кода на TypeScript (#15): только .ts/.tsx.
  // JS-файлы, которые они импортируют, дают типы, но ошибки в них здесь не показываются — их проверяет tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": false,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Только то, что можно просто стереть (без enum, namespace, параметров-свойств):
    // так Node запускает .ts без сборки, а esbuild и Vite собирают каждый файл отдельно
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["engine/**/*.ts", "app/**/*.ts", "app/**/*.tsx", "app/globals.d.ts"]
}
